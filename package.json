{
  "name": "pixly",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-vector-icons/ionicons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-dev-client": "~58.0.15",
    "expo-image": "~58.0.17",
    "expo-media-library": "~58.0.12",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "expo start",
    "prebuild": "npx expo prebuild --no-clean",
    "assembleDebug": "npm run prebuild && cd android && gradlew assembleDebug",
    "assembleRelease": "npm run prebuild && cd android && gradlew assembleRelease",
    "assemblePreview": "npm run prebuild && cd android && gradlew assemblePreview",
    "installDebug": "npm run prebuild && cd android && gradlew installDebug",
    "installPreview": "npm run prebuild && cd android && gradlew installPreview",
    "installRelease": "npm run prebuild && cd android && gradlew installRelease",
    "bundleRelease": "npm run prebuild && cd android && gradlew bundleRelease",
    "installDebugApp": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "installReleaseApp": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "installPreviewApp": "adb install -r android/app/build/outputs/apk/preview/app-preview.apk",
    "installDebugAndPreviewApps": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk && adb install -r android/app/build/outputs/apk/preview/app-preview.apk",
    "lint": "expo lint"
  },
  "private": true
}
